.env
.env.rds
.env.bak-fallback-*
.venv/
data/
.chrome-profile/
__pycache__/
*.pyc
data-mock/
.claude/*
!.claude/skills/
!.claude/settings.json

# Beads / Dolt files (added by bd init)
.dolt/
*.db
.beads-credential-key
.beads/proxieddb/
.beads/interactions.jsonl
# bd's cross-process gate lock, written to the repo root as `.beads.gate.lock`
# (plus suffixed variants) rather than under .beads/, so the patterns above miss it.
*.gate.lock*
web/node_modules/
web/.next/
web/openapi.json
.superpowers/

# Terraform (terraform/)
terraform.tfvars
.terraform/
*.tfstate*
*.tfplan
# deploy/box/rebuild.sh's one-apply lifting of the box's prevent_destroy
terraform/*_override.tf
