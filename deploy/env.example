# Copy to .env beside docker-compose.yml and fill it in (install.sh does). Never commit the filled copy.
# Only what the app needs before it reaches its database lives here; the rest (app URL, push contact, Claude token,
# YouTube key) is set in the app's setup wizard and Settings › App, and kept in the database across upgrades.
# Dev and CLI switches (FFL_WRITES, FFL_NOTIFY, FFL_LIVE, FFL_LEAGUE, FFL_USER, the draft tools' FFL_*) are left out: unset is production.

# The key ring ESPN cookies and the app's settings are sealed with: `uv run python -m ffl.vault keygen`. Keep a copy; a new ring opens no old rows.
FFL_SECRET_KEYS=
# The cron jobs' x-ffl-job header: any long random string (`openssl rand -hex 32`).
FFL_JOB_TOKEN=
# The Postgres password, used by the db container and in the API's FFL_DB_URL: letters and digits only (it goes into a URL and compose interpolates `$`).
POSTGRES_PASSWORD=
# The host port the web app listens on. install.sh moves it up to a free port if it is taken.
FFL_PORT=3300
# The image tag to run (ghcr.io/jonulak/ffl-api and ffl-web).
FFL_VERSION=latest
# The timezone the jobs' schedule and quiet hours run in.
TZ=America/New_York
