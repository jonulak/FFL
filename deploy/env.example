# Copy to .env beside docker-compose.yml and fill it in. Never commit the filled copy.
# Dev and CLI switches (FFL_WRITES, FFL_NOTIFY, FFL_LIVE, FFL_LEAGUE, FFL_USER, the draft tools' FFL_*) are left out: unset is production.

# The key ring ESPN cookies and push keys are sealed with: `uv run python -m ffl.vault keygen`. Keep a copy; a new ring opens no old rows.
FFL_SECRET_KEYS=
# The cron jobs' x-ffl-job header: any long random string (`openssl rand -hex 32`).
FFL_JOB_TOKEN=
# The Postgres password, used by the db container and in the API's FFL_DB_URL: letters and digits only (it goes into a URL and compose interpolates `$`).
POSTGRES_PASSWORD=
# Web push keys: `uv run python -m ffl.notify keys`.
VAPID_PUBLIC_KEY=
# The private half of the pair above.
VAPID_PRIVATE_KEY=
# A contact for push services: change it to your own mailto: address (some push services validate it).
VAPID_SUBJECT=
# The address people open the app at (push links, sign-in redirects and setup links are built off it). Change it
# together with FFL_PORT: the stored URL must name the port the app listens on.
FFL_APP_URL=http://localhost:3300
# The host port the web app listens on; change FFL_APP_URL with it.
FFL_PORT=3300
# The host port Postgres is published on (127.0.0.1 only).
FFL_PG_PORT=5432
# The image tag to run (ghcr.io/white-bridge-labs/ffl-api and ffl-web).
FFL_VERSION=latest
# The timezone the jobs' schedule and quiet hours run in.
TZ=America/New_York
# Projection or news sources this host never asks, comma separated (e.g. sharks,youtube_captions).
FFL_SOURCES_OFF=
# Optional: the YouTube Data API key; without it the news desk reads channels' RSS.
YOUTUBE_API_KEY=
# Optional: how many outlooks are written at once (default 20).
FFL_OUTLOOK_WORKERS=
# Optional: a Claude token for outlooks and news (`claude setup-token`); it can be stored in the app's Settings instead.
CLAUDE_CODE_OAUTH_TOKEN=
